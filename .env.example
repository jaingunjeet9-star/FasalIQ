# ============================================================================
# FasalIQ Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local — it is listed in .gitignore.
# ============================================================================

# ============================================================================
# Server (Express API) — artifacts/api-server
# GEMINI_API_KEY is server-only; it is NOT exposed to the browser.
# ============================================================================
PORT=3000
BASE_PATH=/
NODE_ENV=development

GEMINI_API_KEY=your_gemini_api_key_here
API_SERVER_URL=http://localhost:3000

# ============================================================================
# Frontend (Vite / React) — artifacts/fasaliq
# Variables prefixed with VITE_ are bundled into browser JavaScript.
# Only put genuinely public values here (e.g., public API endpoints).
# ============================================================================

# The frontend calls the local API server via Vite proxy — no API key needed.
# VITE_GEMINI_API_KEY is intentionally absent; keep the key server-side only.

VITE_WEATHER_API_ENDPOINT=https://api.open-meteo.com/v1/forecast

# ============================================================================
# Feature Flags
# ============================================================================
VITE_DEMO_MODE=true
VITE_ENABLE_ANALYTICS=false

# ============================================================================
# Database (Optional — not required for basic MVP)
# ============================================================================
DATABASE_URL=your_postgres_connection_string_here
